{
  "schema_version": "1.0",
  "kind": "module_blueprint",
  "module": {
    "mode": "create",
    "target_module_id": null,
    "local_ref": "local:language",
    "name": "语言学习",
    "description": "通过短时练习积累可核对的语言实践。",
    "icon": "book",
    "color": "blue"
  },
  "record_types": [
    {
      "local_ref": "local:practice_log",
      "name": "语言练习记录",
      "description": "记录实际发生的练习。",
      "renderer_kind": "generic",
      "fields": [
        {
          "key": "topic",
          "label": "练习内容",
          "type": "text",
          "required": true,
          "unit": null,
          "options": [],
          "minimum": null,
          "maximum": null
        },
        {
          "key": "duration_minutes",
          "label": "实际分钟数",
          "type": "integer",
          "required": true,
          "unit": "分钟",
          "options": [],
          "minimum": 1,
          "maximum": 1440
        },
        {
          "key": "reflection",
          "label": "感受或发现",
          "type": "textarea",
          "required": false,
          "unit": null,
          "options": [],
          "minimum": null,
          "maximum": null
        }
      ]
    }
  ],
  "metrics": [
    {
      "local_ref": "local:weekly_minutes",
      "name": "本周练习分钟数",
      "description": "按发生日期聚合已确认且未删除的有效练习记录。",
      "unit": "分钟",
      "source": {
        "record_type_ref": "local:practice_log",
        "aggregation": "sum",
        "field_key": "duration_minutes",
        "window": "week"
      },
      "proposed_target": {
        "operator": "gte",
        "value": 30
      }
    },
    {
      "local_ref": "local:practice_count",
      "name": "累计练习次数",
      "description": "按唯一有效记录计数，不按任务关联数量计数。",
      "unit": "次",
      "source": {
        "record_type_ref": "local:practice_log",
        "aggregation": "count",
        "field_key": null,
        "window": "all_time"
      },
      "proposed_target": null
    }
  ],
  "tasks": [
    {
      "local_ref": "local:first_practice",
      "title": "完成一次语言练习",
      "description": "选择一段内容练习，并如实记录结果。",
      "priority": "normal",
      "estimated_minutes": 10,
      "schedule": {
        "kind": "unscheduled",
        "weekdays": [],
        "local_time": null,
        "start_date": null,
        "end_date": null,
        "timezone": "Asia/Shanghai"
      },
      "completion_mode": "record_required",
      "record_binding": {
        "record_type_ref": "local:practice_log",
        "acceptance": {
          "kind": "field_gte",
          "field_key": "duration_minutes",
          "threshold": 10
        }
      }
    }
  ],
  "achievements": [
    {
      "local_ref": "local:first_step",
      "name": "迈出第一步",
      "description": "留下第一条有效语言练习记录。",
      "icon": "flag",
      "condition": {
        "kind": "metric_threshold",
        "metric_ref": "local:practice_count",
        "operator": "gte",
        "threshold": 1
      },
      "repeat_policy": "once",
      "history_policy": "include_existing"
    }
  ],
  "warnings": [
    "这是内容配置示例，未生成真实学习记录；30 分钟是可编辑建议目标。"
  ]
}
