                "module_ref": {
                  "$ref": "#/$defs/EntityRef"
                },
                "title": {
                  "type": "string",
                  "maxLength": 100
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                },
                "start_date": {
                  "type": "string",
                  "format": "date"
                },
                "target_date": {
