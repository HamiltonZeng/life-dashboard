{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-dashboard.local/schemas/v0.3/ai-decision.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ai-decision/1.0"
    },
    "context_ref": {
      "type": "string",
      "format": "uuid"
    },
    "intent": {
      "type": "string",
      "enum": [
        "answer",
        "plan",
        "record",
        "adjust",
        "report",
        "schedule",
        "clarify"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "proposed_target",
              "configuration_default",
              "authorized_preference"
            ]
          }
        },
        "required": [
          "text",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20
    },
    "clarification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "maxLength": 1000
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "minItems": 0,
              "maxItems": 6
            },
            "blocking_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              },
              "minItems": 1,
              "maxItems": 30
            }
          },
          "required": [
            "question",
            "choices",
            "blocking_fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "context_ref",
    "intent",
    "summary",
    "assumptions",
    "clarification",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "Scalar": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "EntityRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "existing"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "local_ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "local_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "integer",
            "decimal",
            "date",
            "boolean",
            "single_select"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 30
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "required",
        "unit",
        "options",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "Filter": {
      "type": "object",
      "properties": {
        "field_key": {
          "type": "string",
          "maxLength": 64
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "gte",
            "lte"
          ]
        },
        "value": {
          "$ref": "#/$defs/Scalar"
        }
      },
      "required": [
        "field_key",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "TaskRule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linked_exists"
            },
            "record_type_ref": {
              "$ref": "#/$defs/EntityRef"
            }
          },
          "required": [
            "kind",
            "record_type_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linked_field_gte"
            },
            "record_type_ref": {
              "$ref": "#/$defs/EntityRef"
            },
            "field_key": {
              "type": "string",
              "maxLength": 64
            },
            "threshold": {
              "type": "string",
              "pattern": "^-?(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$"
            }
          },
          "required": [
            "kind",
            "record_type_ref",
            "field_key",
            "threshold"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "count",
                "distinct_days"
              ]
            },
            "record_type_ref": {
              "$ref": "#/$defs/EntityRef"
            },
            "threshold": {
              "type": "string",
              "pattern": "^-?(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$"
            },
            "filters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              },
              "minItems": 0,
              "maxItems": 5
            }
          },
          "required": [
            "kind",
            "record_type_ref",
            "threshold",
            "filters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sum"
            },
            "record_type_ref": {
              "$ref": "#/$defs/EntityRef"
            },
            "field_key": {
              "type": "string",
              "maxLength": 64
            },
            "unit": {
              "type": "string",
              "maxLength": 30
            },
            "threshold": {
              "type": "string",
              "pattern": "^-?(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$"
            },
            "filters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              },
              "minItems": 0,
              "maxItems": 5
            }
          },
          "required": [
            "kind",
            "record_type_ref",
            "field_key",
            "unit",
            "threshold",
            "filters"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "active_from": {
          "type": "string",
          "format": "date"
        },
        "active_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "weekdays": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "preferred_local_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "active_from",
        "active_until",
        "weekdays",
        "preferred_local_time"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "field_key": {
          "type": "string",
          "maxLength": 64
        },
        "source_type": {
          "type": "string",
          "enum": [
            "user_statement",
            "authorized_context",
            "unit_conversion"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 100
        },
        "quote": {
          "type": "string",
          "maxLength": 2000
        },
        "original_value": {
          "$ref": "#/$defs/Scalar"
        },
        "original_unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field_key",
        "source_type",
        "evidence_ref",
        "quote",
        "original_value",
        "original_unit"
      ],
      "additionalProperties": false
    },
    "Estimate": {
      "type": "object",
      "properties": {
        "field_key": {
          "type": "string",
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$"
        },
        "unit": {
          "type": "string",
          "maxLength": 30
        },
        "method": {
          "type": "string",
          "maxLength": 1000
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "field_key",
        "value",
        "unit",
        "method",
        "uncertainty",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Values": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Scalar"
      },
      "maxProperties": 30
    },
