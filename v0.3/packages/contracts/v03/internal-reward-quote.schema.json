{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-dashboard.local/schemas/v0.3/internal-reward-quote.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "reward-quote/1.1"
    },
    "policy_version": {
      "const": "reward-policy-ai-v1"
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "template_local_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "rule_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "category": {
                "const": "main"
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "template_local_ref",
              "rule_hash",
              "rationale",
              "category",
              "amount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "template_local_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "rule_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "category": {
                "const": "daily"
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "template_local_ref",
              "rule_hash",
              "rationale",
              "category",
              "amount"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "template_local_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "rule_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "category": {
                "const": "weekly"
              },
              "amount": {
                "type": "integer",
