{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:room:module-blueprint:1.0",
  "title": "Room module blueprint 1.0",
  "description": "Server-side canonical contract. Definitions only; no factual records, current metric values, task completion states, award states, credentials or executable code. Requires semantic and authorization validation after JSON Schema validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "module_blueprint"
    },
    "module": {
      "$ref": "#/$defs/module"
    },
    "record_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record_type"
      },
      "maxItems": 12
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      },
      "maxItems": 20
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 30
    },
    "achievements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/achievement"
      },
      "maxItems": 20
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "kind",
    "module",
    "record_types",
    "metrics",
    "tasks",
    "achievements",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "create",
            "extend"
          ]
        },
        "target_module_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_ref": {
          "type": "string",
          "pattern": "^local:[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "icon": {
          "type": "string",
          "enum": [
            "book",
            "dumbbell",
            "wallet",
            "sparkles",
            "trophy",
            "flag",
            "leaf",
            "music",
            "chat",
            "star"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "blue",
            "green",
            "amber",
            "violet",
            "rose",
            "cyan",
            "slate"
          ]
        }
      },
      "required": [
        "mode",
        "target_module_id",
        "local_ref",
        "name",
        "description",
        "icon",
        "color"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "integer",
            "decimal",
            "date",
            "boolean",
            "single_select"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxItems": 30
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "required",
        "unit",
        "options",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "record_type": {
      "type": "object",
      "properties": {
        "local_ref": {
          "type": "string",
          "pattern": "^local:[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "renderer_kind": {
          "const": "generic"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "local_ref",
        "name",
        "description",
        "renderer_kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "metric_source": {
      "type": "object",
      "properties": {
        "record_type_ref": {
          "type": "string",
          "pattern": "^(local:[a-z][a-z0-9_]{0,63}|id:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "count",
            "sum",
            "avg",
            "latest"
          ]
        },
        "field_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "all_time"
          ]
        }
      },
      "required": [
        "record_type_ref",
        "aggregation",
        "field_key",
        "window"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "local_ref": {
          "type": "string",
          "pattern": "^local:[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "source": {
          "$ref": "#/$defs/metric_source"
        },
        "proposed_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "local_ref",
        "name",
        "description",
        "unit",
        "source",
        "proposed_target"
      ],
      "additionalProperties": false
    },
    "record_acceptance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exists",
            "field_gte"
          ]
        },
        "field_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "field_key",
        "threshold"
      ],
      "additionalProperties": false
    },
    "record_binding": {
      "type": "object",
      "properties": {
        "record_type_ref": {
          "type": "string",
          "pattern": "^(local:[a-z][a-z0-9_]{0,63}|id:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "acceptance": {
          "$ref": "#/$defs/record_acceptance"
        }
      },
      "required": [
        "record_type_ref",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unscheduled",
            "once",
            "daily",
            "weekly"
          ]
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "uniqueItems": true,
          "maxItems": 7
        },
        "local_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "weekdays",
        "local_time",
        "start_date",
        "end_date",
        "timezone"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "local_ref": {
          "type": "string",
          "pattern": "^local:[a-z][a-z0-9_]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "estimated_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "completion_mode": {
          "type": "string",
          "enum": [
            "manual",
            "record_optional",
            "record_required"
          ]
        },
        "record_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_binding"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "local_ref",
        "title",
        "description",
        "priority",
        "estimated_minutes",
        "schedule",
        "completion_mode",
        "record_binding"
      ],
      "additionalProperties": false
    },
    "achievement_condition": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "metric_threshold"
        },
        "metric_ref": {
          "type": "string",
          "pattern": "^(local:[a-z][a-z0-9_]{0,63}|id:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte"
          ]
        },
        "threshold": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "metric_ref",
        "operator",
        "threshold"
      ],
      "additionalProperties": false
    },
    "achievement": {
      "type": "object",
      "properties": {
        "local_ref": {
          "type": "string",
          "pattern": "^local:[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "icon": {
          "type": "string",
          "enum": [
            "book",
            "dumbbell",
            "wallet",
            "sparkles",
            "trophy",
            "flag",
            "leaf",
            "music",
            "chat",
            "star"
          ]
        },
        "condition": {
          "$ref": "#/$defs/achievement_condition"
        },
        "repeat_policy": {
          "type": "string",
          "enum": [
            "once",
            "per_period"
          ]
        },
        "history_policy": {
          "type": "string",
          "enum": [
            "include_existing",
            "from_activation"
          ]
        }
      },
      "required": [
        "local_ref",
        "name",
        "description",
        "icon",
        "condition",
        "repeat_policy",
        "history_policy"
      ],
      "additionalProperties": false
    }
  }
}
